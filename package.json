{
  "name": "message-muncher",
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && tsx watch src/index.ts",
    "build": "npm run build:client && tsc",
    "build:client": "esbuild src/client.ts --bundle --format=esm --target=es2022 --outfile=public/client.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.4.0",
    "@hono/node-server": "^2.1.1",
    "discord.js": "^14.22.1",
    "hono": "^4.13.8",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.10",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
